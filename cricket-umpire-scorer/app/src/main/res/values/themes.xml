<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UmpireScorer" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/bg_surface</item>
        <item name="colorPrimaryDark">@color/bg_primary</item>
        <item name="colorAccent">@color/run_btn</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_score</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Widget.UmpireScorer.Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
