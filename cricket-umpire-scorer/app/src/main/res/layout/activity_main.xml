<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- ── Score banner ─────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:background="@color/bg_score"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textSize="52sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/overText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overs: 0.0"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <!-- ── Current over ball-by-ball chips ──────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/overBallsLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- ── Mode status indicator ────────────────────────────── -->
    <TextView
        android:id="@+id/modeIndicator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:background="@color/bg_surface"
        android:gravity="center"
        android:text="Tap runs — or pick type first"
        android:textSize="13sp"
        android:textColor="@color/text_hint"
        android:paddingBottom="4dp"/>

    <!-- ── Divider ───────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/bg_primary"/>

    <!-- ── Runs row 1: 0 · 1 · 2 ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btn0"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="0"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>

        <Button
            android:id="@+id/btn1"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="1"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>

        <Button
            android:id="@+id/btn2"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="2"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>
    </LinearLayout>

    <!-- ── Runs row 2: 3 · 4 · 6 ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btn3"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="3"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>

        <Button
            android:id="@+id/btn4"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="4"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>

        <Button
            android:id="@+id/btn6"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="6"
            android:textSize="22sp"
            android:backgroundTint="@color/run_btn"/>
    </LinearLayout>

    <!-- ── Extras row 1: Wide · No Ball ─────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/wideBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_wide"
            android:backgroundTint="@color/extras_btn"/>

        <Button
            android:id="@+id/noballBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_noball"
            android:backgroundTint="@color/extras_btn"/>
    </LinearLayout>

    <!-- ── Extras row 2: Bye · Leg Bye ──────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/byeBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_bye"
            android:backgroundTint="@color/bye_btn"/>

        <Button
            android:id="@+id/legbyeBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_legbye"
            android:backgroundTint="@color/bye_btn"/>
    </LinearLayout>

    <!-- ── Wicket (full width) ───────────────────────────────── -->
    <Button
        android:id="@+id/wicketBtn"
        style="@style/Widget.UmpireScorer.Button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/btn_wicket"
        android:textSize="20sp"
        android:backgroundTint="@color/wicket_btn"/>

    <!-- ── Control row: Undo · New Over · Reset ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/undoBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_undo"
            android:textSize="15sp"
            android:backgroundTint="@color/undo_btn"/>

        <Button
            android:id="@+id/newOverBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:layout_margin="3dp"
            android:text="@string/btn_new_over"
            android:textSize="15sp"
            android:backgroundTint="@color/ctrl_btn"/>

        <Button
            android:id="@+id/resetBtn"
            style="@style/Widget.UmpireScorer.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="@string/btn_reset"
            android:textSize="15sp"
            android:backgroundTint="@color/ctrl_btn"/>
    </LinearLayout>

</LinearLayout>
