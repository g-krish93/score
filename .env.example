PORT=5000
# Public site URL used for canonical links and club pages (HTTPS behind reverse proxy), e.g. https://cricrelay.co.uk
PUBLIC_BASE_URL=
# Flask session signing (required in production)
SECRET_KEY=
# Comma-separated allowed browser origins (defaults to cricrelay.co.uk + localhost dev ports)
# CORS_ORIGINS=https://cricrelay.co.uk,https://www.cricrelay.co.uk,http://localhost:5000
# Postgres on RDS, e.g. postgresql+psycopg2://user:pass@host:5432/cricrelay — omit for local SQLite under STATE_DIR
DATABASE_URL=
# Optional: require Bearer token on POST /relay/ingest (same for relay-worker push_match when RELAY_INGEST_TOKEN is set)
RELAY_INGEST_TOKEN=
# Optional: expose /relay-worker/* HTTP routes for debugging (default off)
RELAY_WORKER_HTTP=0
# Optional: relay-worker push to another server (otherwise use push_match for same-app ingest)
PUSH_TARGET_URL=
# Automatic Play-Cricket relay (match day — no manual polling)
RELAY_AUTO_POLL=1
RELAY_POLL_INTERVAL_SEC=10
RELAY_STALE_AFTER_SEC=120
# Optional: absolute path to PCS relay APK for /download/pcs-relay.apk
PCS_RELAY_APK_PATH=
# Optional: absolute path to CricRelay Stream APK for /download/cricrelay-stream.apk
STREAM_APP_APK_PATH=
# YouTube Live (CricRelay Stream app) — Google Cloud OAuth client (Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Defaults to {PUBLIC_BASE_URL}/dashboard/youtube/callback
YOUTUBE_REDIRECT_URI=
# Encrypt stored YouTube/Twitch refresh tokens (required in production — do not fall back to SECRET_KEY)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Stream app API token lifetime (seconds, default 14 days)
STREAM_API_TOKEN_TTL_SEC=1209600
# Allow PCS ingest without token when no per-match token (dev only — default off)
RELAY_ALLOW_OPEN_INGEST=0
# Password reset
PASSWORD_RESET_TTL_SEC=3600
# SMTP for forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cricrelay.co.uk
SMTP_USE_TLS=1
