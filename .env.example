PORT=5000
# Flask session signing (required in production)
SECRET_KEY=
# Postgres on RDS, e.g. postgresql+psycopg2://user:pass@host:5432/cricrelay — omit for local SQLite under STATE_DIR
DATABASE_URL=
# Optional: require Bearer token on POST /relay/ingest (set same value on play-cricket-score-scrapper PUSH_AUTH_TOKEN)
RELAY_INGEST_TOKEN=
